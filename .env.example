# --- Server auth ---
# Token exigido no header "Authorization: Bearer <token>" pra acessar a API (exceto o
# webhook do Zendesk). Gere um valor aleatório forte, ex: openssl rand -hex 32
ORIGINAL_MILES_API_KEY=

# --- API da plataforma Original Miles (src/mastra/services/original-miles-platform.ts) ---
# Chave (header X-API-Key) vinculada à empresa na plataforma — peça ao Thailon.
ORIGINAL_MILES_PLATFORM_API_KEY=
# Opcional. Default: https://app.originalmiles.net/api/v1
ORIGINAL_MILES_PLATFORM_API_URL=

# --- Model providers ---
OPENAI_API_KEY=
# Reserved for future use (not wired into any agent yet)
OPENAI_MODEL=
# Used to embed queries for pesquisar_base_conhecimento (must match the Pinecone index's embedding model)
OPENAI_EMBEDDING_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Supabase (src/mastra/services/supabase.ts) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings > Database > Connection string). Storage da
# memória da Luna (threads/mensagens/working memory), via @mastra/pg. Também usada por
# services/travel-db.ts (tabelas voucher_type/voucher/travel/team) direto via `pg`.
SUPABASE_DB_URL=
# Chave publishable/anon (pública, não secreta) — valida o access_token do usuário (Supabase
# Auth) nas rotas de travel_agent/*, ver services/supabase-auth.ts.
SUPABASE_ANON_KEY=
# Scopes playbooks/knowledge_bases/tasks/conversation_memory queries to Luna's tenant row
OM_TENANT_ID=
# Row in the `agents` table (columns `system_prompt` / `guardrail_prompt`) that Luna's and
# original-miles-guardrail's instructions are read from at runtime, on every generation/classification —
# see getHiveOps().getAgentConfig() / agents/original-miles/original-miles-agent.ts / agents/original-miles-guardrail/original-miles-guardrail-agent.ts
OM_AGENT_ID=

# --- Pinecone (src/mastra/services/pinecone.ts) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- Zendesk (src/mastra/services/zendesk.ts) ---
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_AI_AGENT_SWITCHBOARD_ID=
ZENDESK_APP_ID=
ZENDESK_HUMAN_SWITCHBOARD_ID=
# Auth (Basic: usuário = key ID, senha = key) da Zendesk Conversations API (api.smooch.io)
ZENDESK_CONVERSATIONS_API_KEY_ID=
ZENDESK_CONVERSATIONS_API_KEY=
# Validam a chamada em POST /webhooks/zendesk: o id do webhook (corpo, `webhook.id`) tem que
# bater com ZENDESK_WEBHOOK_ID, e o header `x-api-key` tem que bater com ZENDESK_WEBHOOK_SECRET.
ZENDESK_WEBHOOK_ID=
ZENDESK_WEBHOOK_SECRET=
OM_MESSAGE_BUFFER_MS=
# Horário de atendimento (America/Sao_Paulo). Default: 10-20h
OM_BUSINESS_HOURS_START_HOUR=
OM_BUSINESS_HOURS_END_HOUR=
# Tentativas de gerar resposta da Luna antes de desistir e transferir pra um humano. Default: 3
OM_ASK_MAX_ATTEMPTS=
